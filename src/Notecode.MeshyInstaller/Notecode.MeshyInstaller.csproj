<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>meshy_installer</AssemblyName>
    <RootNamespace>Notecode.MeshyInstaller</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- The version is the version of the Meshy server this installer carries.
         It is stamped in by scripts/build-meshy-installer.ps1, so the installer
         says which server it installs and can tell an update from a reinstall. -->
    <Version>0.0.0</Version>
    <Product>Meshy for notecode</Product>
    <Company>notecode</Company>
    <Description>Installs Meshy's MCP server for notecode. It is not part of notecode itself.</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The payload is the built server and its packages, zipped by
         scripts/build-meshy-installer.ps1. It is only there when the script
         has run, so a fresh clone still builds. -->
    <EmbeddedResource Include="..\..\installer\meshy-payload.zip"
                      Condition="Exists('..\..\installer\meshy-payload.zip')">
      <LogicalName>meshy-payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
