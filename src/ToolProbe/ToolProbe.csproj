<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ToolProbe</AssemblyName>
    <RootNamespace>Notecode.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the real sources so the probe exercises shipping code, not a copy. -->
    <Compile Include="..\Notecode.App\AppConfig.cs" Link="AppConfig.cs" />
    <Compile Include="..\Notecode.App\AppLog.cs" Link="AppLog.cs" />
    <Compile Include="..\Notecode.App\ChatTools.cs" Link="ChatTools.cs" />
    <Compile Include="..\Notecode.App\FileTypes.cs" Link="FileTypes.cs" />
    <Compile Include="..\Notecode.App\LlamaServer.cs" Link="LlamaServer.cs" />
    <Compile Include="..\Notecode.App\SlashCommands.cs" Link="SlashCommands.cs" />
    <Compile Include="..\Notecode.App\Providers.cs" Link="Providers.cs" />
    <Compile Include="..\Notecode.App\Gguf.cs" Link="Gguf.cs" />
    <Compile Include="..\Notecode.App\EndpointDoctor.cs" Link="EndpointDoctor.cs" />
    <Compile Include="..\Notecode.App\ProviderClient.cs" Link="ProviderClient.cs" />
    <!-- The hardware layer. AppConfig and LlamaServer both refer to these types,
         so the probe has to compile them too. -->
    <Compile Include="..\Notecode.App\BackendSelector.cs" Link="BackendSelector.cs" />
    <Compile Include="..\Notecode.App\HardwareProfile.cs" Link="HardwareProfile.cs" />
    <Compile Include="..\Notecode.App\HardwareScanner.cs" Link="HardwareScanner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>

