  "sniff": {
    "$comment": "Content sniffing, used only when the extension is unknown or absent. First match wins.",
    "rules": [
      { "ext": "php", "startsWith": "<?php" },
      { "ext": "php", "contains": "?>" },
      { "ext": "html", "startsWith": "<!DOCTYPE html" },
      { "ext": "html", "startsWith": "<!doctype html" },
      { "ext": "html", "startsWith": "<html" },
      { "ext": "svg", "startsWith": "<svg" },
      { "ext": "xml", "startsWith": "<?xml" },
      { "ext": "dockerfile", "startsWith": "FROM " },
      { "ext": "sh", "startsWith": "#!/bin/sh" },
      { "ext": "sh", "startsWith": "#!/usr/bin/env bash" },
      { "ext": "sh", "startsWith": "#!/usr/bin/env zsh" },
      { "ext": "py", "startsWith": "#!/usr/bin/env python" },
      { "ext": "py", "startsWith": "#!/usr/bin/python" },
      { "ext": "ruby", "startsWith": "#!/usr/bin/env ruby" },
      { "ext": "lua", "startsWith": "#!/usr/bin/env lua" },
      { "ext": "diff", "startsWith": "diff --git" },
      { "ext": "diff", "startsWith": "--- " },
      { "ext": "md", "startsWith": "# " },
      { "ext": "json", "startsWith": "{" },
      { "ext": "json", "startsWith": "[" }
    ]
  },

  "binary": [
    "png", "jpg", "jpeg", "gif", "bmp", "ico", "webp", "tiff", "avif",
    "pdf", "zip", "gz", "tar", "7z", "rar", "bz2", "xz",
    "exe", "dll", "so", "dylib", "obj", "lib", "pdb",
    "gguf", "bin", "dat", "pack", "idx", "onnx", "pt", "pth", "safetensors",
    "mp3", "wav", "flac", "ogg", "mp4", "mkv", "mov", "avi",
    "ttf", "otf", "woff", "woff2", "eot"
  ],

  "defaultMode": "text/plain"
}
